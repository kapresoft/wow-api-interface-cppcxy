      "param-type-mismatch",
      "missing-fields",
      "need-check-nil"
    ],
    "globals": [
      "ACCEPT",
      "AddonList",
      "AnchorUtil",
      "APIDocumentation",
      "assertsafe",
      "BACKDROP_TOAST_12_12",
      "CANCEL",
      "ChatFrame1",
      "ChatFrame1Tab",
      "ChatTypeInfo",
      "CreateAnchor",
      "CreateColorFromRGBHexString",
      "DEFAULT_CHAT_FRAME",
      "DEVTOOLS_LONG_STRING_CUTOFF",
      "FCF_SetWindowAlpha",
      "FCF_SetWindowColor",
      "FramerateFrame",
      "FrameStackTooltip",
      "FrameUtil",
      "LibStub",
      "NO",
      "OKAY",
      "pformat",
      "PlayerFrame",
      "RaidNotice_AddMessage",
      "RaidWarningFrame",
      "RegisterStateDriver",
      "ReloadUI",
      "SELECTED_CHAT_FRAME",
      "Settings",
      "SettingsPanel",
      "SlashCmdList",
      "SOUNDKIT",
      "StaticPopup_Visible",
      "StaticPopupDialogs",
      "TargetFrame",
      "UIParentLoadAddOn",
      "UISpecialFrames",
      "UIWidgetTopCenterContainerFrame",
      "YES"
    ]
  },
  "workspace": {
    "library": [
      "/Users/tony/sandbox/github/kapresoft/wow/tools/vscode-wow-api-cppcxy/Annotations"
    ],
    "ignoreDir": [
      "legacy",
      "build", "dist", "doc", "dev"
    ],
    "ignoreGlobs": [
      "**/_*",
      "**/_*/**",
      "**/.*",
      "**/.*/**"
    ]
  }
}
